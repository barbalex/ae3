# Template for backend/.env on the production server — copy to .env and
# fill in the values. See CLAUDE.md "Deploying the backend".
# A `$` inside a value must be escaped as `$$` (docker compose interpolation).

# db superuser; also the psql target for manual commands:
# docker exec -it ae_db psql -U postgres -d ae
POSTGRES_USER=postgres

# password of the db superuser, set on first volume init
POSTGRES_PASSWORD=

# signs the JWTs of ae.login and verifies them in PostgREST
# (PGRST_JWT_SECRET). Must be >= 32 chars: PostGREST's jose library
# rejects shorter HMAC secrets.
JWT_SECRET=

# password of the db role "authenticator"; must match the password
# embedded in DATABASE_URL
AUTHENTICATOR_PASSWORD=

# connection string for the postgrest container (PGRST_DB_URI); runs in
# the same compose network, so db service name and container port
DATABASE_URL=postgres://authenticator:<password>@db:5432/ae

# caddy / Let's Encrypt (the ACME email is also set in caddy/Caddyfile)
ACME_AGREE=true
ACME_EMAIL=
