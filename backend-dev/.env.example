# Template for backend-dev/.env — copy to .env and fill in the values.
# See CLAUDE.md "Backend (Docker)".
# A `$` inside a value must be escaped as `$$` (docker compose interpolation).

# db superuser created on first volume init; also the psql target for
# manual commands: docker exec -it ae_db psql -U postgres -d ae
POSTGRES_USER=postgres

# password of the db superuser, set on first volume init
POSTGRES_PASSWORD=

# signs the JWTs of ae.login and verifies them in PostgREST
# (PGRST_JWT_SECRET). Must be >= 32 chars: PostgREST's jose library
# rejects shorter HMAC secrets.
JWT_SECRET=

# intended password of the db role "authenticator". BEWARE: sql init
# files get NO env substitution, so on a fresh volume 01_db_users_roles.sql
# sets the role password to the literal string "${AUTHENTICATOR_PASSWORD}".
# The simplest working setup keeps that literal ($$-escaped) in
# DATABASE_URL below — see the next block.
AUTHENTICATOR_PASSWORD=

# connection string for the postgrest container (PGRST_DB_URI), pointing
# at the db's published host port (ae3 dev port block: 5433/8093). The
# password below is the literal from 01_db_users_roles.sql; alternatively
# ALTER ROLE authenticator with a real password and use that in both places.
DATABASE_URL=postgres://authenticator:$${AUTHENTICATOR_PASSWORD}@host.docker.internal:5433/ae

# container/compose naming
COMPOSE_PROJECT_NAME=ae
