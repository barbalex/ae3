# build-time env for production (Vercel runs `vite build` for arteigenschaften.ch
# and artdaten.ch, which picks this file up and embeds the values). Activates
# the opt-in client error reporter (src/modules/errorTelemetry.ts) — the
# collector is a PostgREST table on the production api (see
# backend/db/migrations/2026-11-14-error-report.sql). No secrets here: the
# endpoint accepts anonymous inserts only.
VITE_ERROR_TELEMETRY_URL=https://api.arteigenschaften.ch/postgrest/error_report
